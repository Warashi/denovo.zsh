{
  "lock": false,
  "workspace": [
    "denovo/@denovo-private"
  ],
  "tasks": {
    "check": "deno check denovo/**/*.ts",
    "test": "deno task test:shell && deno task test:deno",
    "test:coverage": "deno task test:shell:coverage && deno task test:deno:coverage",
    "test:shell": "shellspec --chdir shell",
    "test:shell:coverage": "deno task test:shell --kcov",
    "test:deno": "deno test -A --doc --parallel --shuffle denovo/**/*.ts",
    "test:deno:coverage": "deno task test:deno --coverage=.coverage --coverage-raw-data-only && deno task coverage",
    "coverage": "deno coverage .coverage --exclude='/tmp/'",
    "bench": "deno bench -A"
  }
}
